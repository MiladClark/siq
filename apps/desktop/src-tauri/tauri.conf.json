{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "siq",
  "version": "0.4.0",
  "identifier": "app.siq.desktop",
  "build": {
    "beforeDevCommand": "pnpm run ui",
    "beforeBuildCommand": "pnpm run ui",
    "frontendDist": "../out"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "siq",
        "width": 1320,
        "height": 840,
        "minWidth": 390,
        "minHeight": 580,
        "center": true,
        "resizable": true,
        "decorations": false,
        "shadow": false,
        "transparent": true,
        "useHttpsScheme": true,
        "backgroundColor": "#00000000",
        "additionalBrowserArgs": "--autoplay-policy=no-user-gesture-required"
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self' https://tauri.localhost",
        "script-src": "'self' 'wasm-unsafe-eval' blob: https://tauri.localhost",
        "style-src": "'self' 'unsafe-inline'",
        "connect-src": "'self' ipc: http://ipc.localhost https: wss: blob: data:",
        "img-src": "'self' https: data: blob:",
        "media-src": "'self' https: blob: data: mediastream:",
        "worker-src": "'self' blob:",
        "child-src": "'self' blob:",
        "object-src": "'none'",
        "base-uri": "'none'",
        "frame-src": "'none'"
      }
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
