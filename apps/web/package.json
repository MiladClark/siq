{
  "name": "@siq/web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "siq-sync-assets public && dotenv -e ../../.env.local -- next dev --turbopack -p 3100",
    "build": "siq-sync-assets public && dotenv -e ../../.env.local -- next build",
    "start": "dotenv -e ../../.env.local -- next start -p 3100",
    "typecheck": "tsc --noEmit",
    "db:push": "dotenv -e ../../.env.local -- drizzle-kit push",
    "db:generate": "dotenv -e ../../.env.local -- drizzle-kit generate",
    "db:studio": "dotenv -e ../../.env.local -- drizzle-kit studio"
  },
  "dependencies": {
    "@siq/shared": "workspace:*",
    "@neondatabase/serverless": "^1.0.2",
    "@vercel/blob": "^2.9.0",
    "bcryptjs": "^3.0.2",
    "drizzle-orm": "^0.44.2",
    "jose": "^6.0.11",
    "livekit-server-sdk": "^2.20.1",
    "next": "^15.3.3",
    "pg": "^8.23.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zod": "^3.25.51"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.8",
    "@types/node": "^22.15.29",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.1.6",
    "@types/react-dom": "^19.1.5",
    "dotenv-cli": "^8.0.0",
    "drizzle-kit": "^0.31.1",
    "tailwindcss": "^4.1.8",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  }
}
