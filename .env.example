# PostgreSQL
# - On Vercel: Neon Postgres (automatically set via Vercel Storage)
# - Local Docker: postgresql://siq:siq@localhost:5439/siq
DATABASE_URL="postgresql://siq:siq@localhost:5439/siq"

# Session signing secret (generate a random 32+ char string for production)
AUTH_SECRET="replace-with-a-random-32-character-secret-string"

# LiveKit (LiveKit Cloud for Vercel, or ws://localhost:7880 with devkey/secret in local Docker)
NEXT_PUBLIC_LIVEKIT_URL="ws://localhost:7880"
LIVEKIT_API_KEY="devkey"
LIVEKIT_API_SECRET="secret"

# Vercel Blob (leave empty in local dev to use .local-uploads/ automatically)
BLOB_READ_WRITE_TOKEN=""
