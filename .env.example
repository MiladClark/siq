# PostgreSQL (Neon on Vercel Marketplace, or local/VPS Postgres)
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Session signing secret (generate a random 32+ char string)
AUTH_SECRET="replace-with-a-random-32-character-secret-string"

# LiveKit (Phase 3 - LiveKit Cloud or self-hosted LiveKit Docker)
NEXT_PUBLIC_LIVEKIT_URL="wss://your-project.livekit.cloud"
LIVEKIT_API_KEY=""
LIVEKIT_API_SECRET=""

# Vercel Blob (Phase 4 - file and image uploads in text chat)
BLOB_READ_WRITE_TOKEN=""
