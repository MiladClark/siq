{
  "name": "siq",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.24.0",
  "scripts": {
    "dev": "pnpm --filter @siq/web run dev",
    "build": "pnpm --filter @siq/web run build",
    "start": "pnpm --filter @siq/web run start",
    "lint": "eslint .",
    "typecheck": "pnpm -r run typecheck",
    "desktop:ui": "pnpm --filter @siq/desktop run ui",
    "desktop:dev": "pnpm --filter @siq/desktop run dev",
    "desktop:build": "pnpm --filter @siq/desktop run build",
    "db:push": "pnpm --filter @siq/web run db:push",
    "db:generate": "pnpm --filter @siq/web run db:generate",
    "db:studio": "pnpm --filter @siq/web run db:studio"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@types/react": "^19.1.6",
    "@types/react-dom": "^19.1.5",
    "eslint": "^9.39.5",
    "eslint-config-next": "15.5.29"
  }
}
